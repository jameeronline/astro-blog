---
//astro imports
import { Icon } from "astro-icon/components";

//components imports
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/framework-ui/ContactForm";

//icons imports
import { Clock, Mail, MapPin, MessageSquare, Phone } from "@lucide/astro";
// import ContactForm from "../blocks/ContactForm.astro";

// const Contact = () => {
//   const [selectedTab, setSelectedTab] = useState("contact");

const selectedTab = "contact";

//page meta data
const title = "Contact";

// Contact info data
const contactInfo = [
  {
    icon: Mail,
    title: "Email",
    content: "hello@johndeveloper.com",
    link: "mailto:hello@johndeveloper.com",
  },
  {
    icon: Phone,
    title: "Phone",
    content: "+1 (555) 123-4567",
    link: "tel:+15551234567",
  },
  {
    icon: MapPin,
    title: "Location",
    content: "San Francisco, CA",
    link: "#",
  },
  {
    icon: Clock,
    title: "Availability",
    content: "Mon-Fri: 9AM - 6PM PST",
    link: "#",
  },
];
---

<BaseLayout title={title}>
  {/* Page Title */}
  {/* Hero Section */}
  <section class="container-tight my-16">
    <div class="max-w-3xl mx-auto text-center space-y-6">
      <p class="text-caption">Get in Touch</p>
      <h1 class="" style={{ animationDelay: "200ms" }}>
        Let's Work <span class="text-mint">Together</span>
      </h1>
      <p
        class="text-lg text-muted-foreground"
        style={{ animationDelay: "400ms" }}
      >
        Have a project in mind or just want to say hello? Feel free to reach
        out. I'm always open to discussing new opportunities and ideas.
      </p>
    </div>
  </section>

  <ContactForm />

  {/* Contact Section */}
  <section class="container-tight mb-20">
    <div class="glass-card overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-5">
        {/* Contact info sidebar */}
        <div class="lg:col-span-2 bg-navy p-8 lg:p-12 space-y-8">
          <div class="space-y-3">
            <h2 class="text-2xl font-bold">Contact Information</h2>
            <p class="text-slate-light">
              Fill out the form and I'll get back to you as soon as possible.
            </p>
          </div>

          <div class="space-y-6">
            {
              contactInfo.map((item, index) => (
                <a
                  key={index}
                  href={item.link}
                  class="flex items-start space-x-4 hover:text-mint transition-colors"
                >
                  <div class="p-3 rounded-full bg-navy-light">
                    <item.icon />
                  </div>
                  <div>
                    <h3 class="font-bold ">{item.title}</h3>
                    <p class="text-slate-light">{item.content}</p>
                  </div>
                </a>
              ))
            }
          </div>

          {/* Social links */}
          <div class="pt-8 border-t border-white/10">
            <h3 class="font-bold mb-4">Connect With Me</h3>
            <div class="flex space-x-4">
              <a
                href="https://github.com/yourusername"
                target="_blank"
                rel="noopener noreferrer"
                class="p-3 rounded-full bg-navy-light hover:bg-mint hover:text-navy transition-colors"
                aria-label="GitHub profile"
              >
                <Icon name="brands/github" class="w-6 h-6" />
              </a>
              <a
                href="https://linkedin.com/in/yourusername"
                target="_blank"
                rel="noopener noreferrer"
                class="p-3 rounded-full bg-navy-light hover:bg-mint hover:text-navy transition-colors"
                aria-label="LinkedIn profile"
              >
                <Icon name="brands/linkedin" class="w-6 h-6" />
              </a>
              <a
                href="https://twitter.com/yourusername"
                target="_blank"
                rel="noopener noreferrer"
                class="p-3 rounded-full bg-navy-light hover:bg-mint hover:text-navy transition-colors"
                aria-label="Twitter profile"
              >
                <Icon name="brands/x" class="w-6 h-6" />
              </a>
            </div>
          </div>
        </div>

        {/* Form container */}
        <div class="lg:col-span-3 p-8 lg:p-12">
          <div class="mb-8">
            <div class="flex border-b border-border">
              <button
                class={`pb-4 px-4 font-medium transition-colors ${
                  selectedTab === "contact"
                    ? "text-mint border-b-2 border-mint"
                    : "text-muted-foreground hover:text-foreground"
                }`}
                onClick={() => setSelectedTab("contact")}
              >
                <MessageSquare size={18} class="inline-block mr-2" />
                Contact Form
              </button>
              <button
                class={`pb-4 px-4 font-medium transition-colors ${
                  selectedTab === "calendar"
                    ? "text-mint border-b-2 border-mint"
                    : "text-muted-foreground hover:text-foreground"
                }`}
                onClick={() => setSelectedTab("calendar")}
              >
                <Clock size={18} class="inline-block mr-2" />
                Book a Call
              </button>
            </div>
          </div>

          {
            selectedTab === "contact" ? (
              <ContactForm />
            ) : (
              <div class="space-y-6">
                <p class="text-muted-foreground">
                  Prefer a direct conversation? Schedule a 30-minute call at
                  your convenience.
                </p>

                <div class="glass-card p-6">
                  <iframe
                    src="about:blank"
                    Replace
                    with
                    actual
                    calendar
                    embed
                    title="Book a call"
                    class="w-full h-[450px] border-0"
                  />
                </div>

                <p class="text-sm text-muted-foreground">
                  Can't find a suitable time? Send me an email, and we'll find a
                  time that works for both of us.
                </p>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {/* FAQ Section */}
  <section class="container-tight py-16 mb-20">
    <div class="text-center mb-12">
      <p class="subtitle">FAQ</p>
      <h2 class="text-3xl font-bold">Frequently Asked Questions</h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="glass-card p-6 space-y-3">
        <h3 class="text-xl font-bold">What services do you offer?</h3>
        <p class="text-muted-foreground">
          I specialize in frontend development, UI/UX implementation, web
          application development, and performance optimization. I can help with
          everything from small components to full-scale applications.
        </p>
      </div>

      <div class="glass-card p-6 space-y-3">
        <h3 class="text-xl font-bold">What is your typical process?</h3>
        <p class="text-muted-foreground">
          My process typically involves an initial consultation, proposal/scope
          definition, design implementation, development, testing, and
          deployment. I maintain clear communication throughout each phase.
        </p>
      </div>

      <div class="glass-card p-6 space-y-3">
        <h3 class="text-xl font-bold">How long does a typical project take?</h3>
        <p class="text-muted-foreground">
          Project timelines vary based on scope and complexity. A small project
          might take 2-4 weeks, while larger applications can take several
          months. I'll provide a detailed timeline during our initial
          consultation.
        </p>
      </div>

      <div class="glass-card p-6 space-y-3">
        <h3 class="text-xl font-bold">Do you offer ongoing maintenance?</h3>
        <p class="text-muted-foreground">
          Yes, I offer maintenance packages to ensure your application stays
          up-to-date, secure, and performs well. This can include regular
          updates, performance monitoring, and feature additions.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
