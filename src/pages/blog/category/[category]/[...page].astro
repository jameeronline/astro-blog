export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = await getCollection("posts");

  // Collect all unique categories from posts
  const categoriesSet = new Set();
  for (const post of posts) {
    if (Array.isArray(post.data.categories)) {
      const categories = await getEntries(post.data.categories);
      categories.forEach((category) => categoriesSet.add(category.data));
    }
  }

  // Generate a path for each unique category, passing only posts related to that category
  const paths = [];

  for (const category of categoriesSet) {
    const slug = category.slug;   // assuming item has .slug
    const title = category.title; // assuming .title

    const filteredPosts = [];

    for (const post of posts) {
      if (!Array.isArray(post.data.categories)) continue;

      const postCategories = await getEntries(post.data.categories);

      const belongsToCategory = postCategories.some(
        cat => cat.data.slug === slug
      );

      if (belongsToCategory) {
        filteredPosts.push(post);
      }
    }

    const pages = paginate(filteredPosts, {
      params: { category: slug },
      props: { 
        posts: filteredPosts,
        categoryName: title 
      },
      pageSize: 2,
    });

    paths.push(...pages);
  }

  return paths;
}

const { categoryName, page } = Astro.props;

const selected = "all";
const noPosts = !page || page.data.length === 0;
---

<BaseLayout pageTitle={selected}>
  <section>
    <header class="mx-auto flex flex-col items-center gap-2 mb-10">
      <span class="text-caption">Posts in category</span>
      <h2 class="mb-4 text-center text-4xl font-semibold text-heading text-primary-800">
        <span class="capitalize">{categoryName}</span>
      </h2>
    </header>

    <!-- <TagFilter selected={selected} /> -->
    {
      noPosts ? (
        <div class="text-red-600 py-8 text-center font-semibold">
          No posts found for category: {categoryName}
        </div>
      ) : (
        <BlogGrid posts={page.data} />
        <Paginate 
            currentPage={page.currentPage} 
            lastPage={page.lastPage} 
            prevUrl={page.url.prev} 
            nextUrl={page.url.next}
        />
      )
    }
  </section>
</BaseLayout>
