---
//astro imports
import { getCollection } from "astro:content";

//components import
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogGrid from "@blocks/BlogGrid.astro";
import Paginate from "@components/Paginate.astro";

//utils import
import { slugify } from "@utils/helper";

//site config
import { siteConfig } from "../../config/siteconfig.ts";

//page meta data
const pageTitle = "Blog Index";

// Pagination setup
export async function getStaticPaths({ paginate }) {
  // Get all posts (you can add sorting/filtering here)
  const allPosts = await getCollection("posts");
  const { pageLength } = siteConfig;

  // Sort posts by date (newest first)
  const sortedPosts = allPosts.sort(
    (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
  );

  return paginate(sortedPosts, {
    pageSize: pageLength, // Number of posts per page
  });
}

//props
const { page } = Astro.props;
---

<BaseLayout title={pageTitle}>
  <section class="py-16">
    <header
      class="mx-auto flex max-w-screen-md flex-col items-center gap-6 mb-16 intersect:animate-delay-150 intersect:animate-fade-up intersect-once"
      transition:name="blog-title"
    >
      <h2 class="mb-4 text-center text-3xl font-semibold lg:text-5xl">
        Welcome to the Blog
      </h2>
      <p class="text-balance text-center text-zinc-600 lg:text-xl">
        Explore our latest articles, tutorials, and insights on web development,
        Astro, and more. Stay updated with tips, guides, and case studies from
        our team.
      </p>
    </header>

    <BlogGrid posts={page.data} />

    <!-- Pagination Controls -->
    <Paginate
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
    />
  </section>
</BaseLayout>
