---
//astro imports
import { getCollection } from "astro:content";

//layouts imports
import BaseLayout from "@layouts/BaseLayout.astro";

import { getStaticPaths } from "./tags/[tag].astro";

//blocks imports
import Hero from "@blocks/Hero.astro";
import Features from "@blocks/Features.astro";
import Popular from "@blocks/Popular.astro";
import Testimonial from "@blocks/Testimonial.astro";
import FeaturedCards from "@blocks/FeaturedCards.astro";
import TrustedBrands from "@blocks/TrustedBrands.astro";
import FAQ from "@blocks/FAQ.astro";
import CTA from "@blocks/CTA.astro";
import HomeBlogGrid from "@blocks/HomeBlogGrid.astro";
import FeaturedPosts from "@blocks/FeaturedPosts.astro";

export interface User {
  id: number;
  name: string;
  username: string;
  email: string;
  address: {
    street: string;
    suite: string;
    city: string;
    zipcode: string;
    geo: {
      lat: string;
      lng: string;
    };
  };
  phone: string;
  website: string;
  company: {
    name: string;
    catchPhrase: string;
    bs: string;
  };
}

//fetch users
// const users: User[] = await fetch("https://jsonplaceholder.typicode.com/users")
//   .then((res) => res.json())
//   .then((data) => data);

// console.log(users);

//page metadata
const pageTitle = "Home Page";

//posts
const posts = await getCollection("posts");
const featuredPosts = posts.filter((post) => post.data.featured);
---

<BaseLayout title={pageTitle}>
  <!-- <FeaturedPosts posts={featuredPosts} /> -->
  <Hero title="Welcome to my site" subtitle="This is a subtitle" />
  <!-- <TrustedBrands /> -->
  <!-- <FeaturedCards /> -->
  <!-- <Features title="Features" subtitle="This is a subtitle" /> -->
  <Popular />
  <Testimonial />
  <!-- <FAQ /> -->
  <HomeBlogGrid />
</BaseLayout>
