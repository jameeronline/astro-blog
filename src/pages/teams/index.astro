---
//astro imports
import { getCollection, getEntry } from "astro:content";
import Image from "astro/components/Image.astro";

//components import
import BaseLayout from "@layouts/BaseLayout.astro";

//page metadata
const title = "Teams Page";
const description = "This is the projects page";

const teams = await getCollection("teams");
---

<BaseLayout title={title} description={description}>
  <section>
    <header
      class="mx-auto flex flex-col items-center text-center lg:max-w-3xl gap-6 mb-16"
      data-scroll-animate
    >
      <p class="text-caption" data-scroll-animate>Our team</p>
      <h1 class="text-heading mt-2 mb-2" data-scroll-animate>
        The team you&#x27;ll be working with
      </h1>
      <p class="text-lead" data-scroll-animate>
        Meet our talented and passionate team dedicated to delivering
        exceptional results. Each member brings unique skills and experience to
        help drive our projects forward and ensure your success.
      </p>
    </header>
    <div
      class="container mt-16 grid gap-x-12 gap-y-16 md:grid-cols-2 lg:grid-cols-4"
    >
      {
        teams.map(({ data }) => (
          <article data-scroll-animate>
            <div class="flex flex-col items-center text-center">
              <Image
                src={data.picture}
                alt={data.name}
                class="relative flex shrink-0 overflow-hidden rounded-full mb-4 grayscale hover:grayscale-0 size-20 md:mb-5 lg:size-24"
                width={96}
                height={96}
              />
              <p class="font-semibold">{data.name}</p>
              <p class="text-gray-600">{data.role}</p>
              <p class="py-3 text-sm text-gray-600">{data.description}</p>
              <div class="mt-10" />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
