---
//astro imports
import { getCollection, getEntry } from "astro:content";
import Image from "astro/components/Image.astro";

//components import
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@blocks/PageHeader.astro";

//page metadata
const title = "Teams Page";
const description = "This is the projects page";

const teams = await getCollection("teams");

// page header details
const pageHeader = {
  title: "The team you'll be working with",
  caption: "Our team",
  description:
    "Meet our talented and passionate team dedicated to delivering exceptional results. Each member brings unique skills and experience to help drive our projects forward and ensure your success.",
};
---

<BaseLayout title={title} description={description}>
  <section>
    <PageHeader
      title={pageHeader.title}
      description={pageHeader.description}
      caption={pageHeader.caption}
    />

    <div
      class="container mt-16 grid gap-x-12 gap-y-16 md:grid-cols-2 lg:grid-cols-4"
    >
      {
        teams.map(({ data }) => (
          <article data-scroll-animate>
            <div class="flex flex-col items-center text-center">
              <Image
                src={data.picture}
                alt={data.name}
                class="relative flex shrink-0 overflow-hidden rounded-full mb-4 grayscale hover:grayscale-0 size-20 md:mb-5 lg:size-24"
                width={96}
                height={96}
              />
              <p class="font-semibold">{data.name}</p>
              <p class="text-gray-600">{data.role}</p>
              <p class="py-3 text-sm text-gray-600">{data.description}</p>
              <div class="mt-10" />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
