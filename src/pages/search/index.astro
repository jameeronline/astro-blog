---
//astro imports
import { getCollection } from "astro:content";

//utils imports
import { getSearchIndex } from "@utils/search";

//components imports
import BaseLayout from "@layouts/BaseLayout.astro";
import SearchForm from "@blocks/SearchForm.astro";
import BlogGrid from "@blocks/BlogGrid.astro";
import PageHeader from "@blocks/PageHeader.astro";

export const prerender = false; // Disable pre rendering for dynamic search results

const posts = await getCollection("posts");
const searchIndex = await getSearchIndex(posts);

// Get the search term from the URL query
const url = new URL(Astro.request.url);
const searchTerm = url.searchParams.get("q") || "";

// Filter results on the server
let results: typeof posts = [];
if (searchTerm.trim()) {
  const term = searchTerm.toLowerCase();
  results = posts.filter(
    ({ data }) =>
      data.title.toLowerCase().includes(term) ||
      data.description.toLowerCase().includes(term) ||
      (data.tags && data.tags.some((tag) => tag.toLowerCase().includes(term)))
  );
}

// page header details
const pageHeader = {
  title: "Search Articles",
  caption: "Find the info",
  description: "Type to search for articles by title, content, or tags.",
};
---

<BaseLayout title="Search Articles">
  <PageHeader
    title={pageHeader.title}
    description={pageHeader.description}
    caption={pageHeader.caption}
  />

  <SearchForm value={searchTerm} />

  {
    results.length > 0 ? (
      <div class="search-results">
        <BlogGrid posts={results} />
      </div>
    ) : searchTerm ? (
      <div class="text-red-600 py-8 text-center font-semibold">
        No results found.
      </div>
    ) : null
  }
</BaseLayout>
