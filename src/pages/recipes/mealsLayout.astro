---
import BaseLayout from "../../layouts/BaseLayout.astro";

import axios from "axios";

import { textToSlug } from "../../utils/helper";

let responseDataCategories = null;
let errorMessage = null;

try {
  const response = await axios.get(
    "https://www.themealdb.com/api/json/v1/1/list.php?c=list"
  );
  responseDataCategories = response.data;
} catch (error) {
  console.error("Error fetching data:", error);
  errorMessage = "Failed to load data. Please try again later.";
}

let responseDataAreas = null;

try {
  const responseAreas = await axios.get(
    "https://www.themealdb.com/api/json/v1/1/list.php?a=list"
  );
  responseDataAreas = responseAreas.data;
} catch (error) {
  console.error("Error fetching area data:", error);
  errorMessage = "Failed to load area data. Please try again later.";
}
const { title } = Astro.props;
---

<BaseLayout pageTitle={title || "Dashboard"}>
  <section class="py-16">
    <header>
      <h1 class="text-3xl font-bold mb-2">Meals Dashboard</h1>
      <p class="text-gray-700 mb-8">
        Welcome to your dashboard. Here you can manage your content and
        settings.
      </p>
    </header>

    <div class="grid grid-cols-4 gap-6 md:grid-cols-8 lg:grid-cols-12">
      <div class="col-span-4 lg:col-span-2">
        <ul>
          {
            responseDataCategories && responseDataCategories.meals && (
              <div class="areas-section mt-8">
                <h3 class="text-xl font-bold mb-4">Categories</h3>
                {responseDataCategories.meals.map((meal) => (
                  <li key={meal.strCategory}>
                    <a
                      href={`/recipes/categories/${textToSlug(meal.strCategory)}`}
                    >
                      <span>{meal.strCategory}</span>
                    </a>
                  </li>
                ))}
              </div>
            )
          }
        </ul>

        <ul>
          {
            responseDataAreas && responseDataAreas.meals && (
              <div class="areas-section mt-8">
                <h3 class="text-xl font-bold mb-4">Areas</h3>
                {responseDataAreas.meals.map((area) => (
                  <li>
                    <a
                      href={`/recipes/areas/${textToSlug(area.strArea)}`}
                      key={area.strArea}
                    >
                      <span>{area.strArea}</span>
                    </a>
                  </li>
                ))}
              </div>
            )
          }
        </ul>
      </div>
      <div class="col-span-4 lg:col-span-9">
        <!-- Content management section -->
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
