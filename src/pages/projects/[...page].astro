---
//astro imports
import { getCollection, getEntry } from "astro:content";

//components imports
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";

//utils imports
import { slugify } from "@utils/helper";

//site config
import { siteConfig } from "@config/siteConfig.ts";

const delayClasses = [
  "intersect:animate-delay-[0ms]",
  "intersect:animate-delay-[100ms]",
  "intersect:animate-delay-[200ms]",
  "intersect:animate-delay-[300ms]",
  "intersect:animate-delay-[400ms]",
  "intersect:animate-delay-[500ms]",
  "intersect:animate-delay-[600ms]",
  "intersect:animate-delay-[700ms]",
  "intersect:animate-delay-[800ms]",
  "intersect:animate-delay-[900ms]",
];

//page metadata
const title = "Projects Page";
const description = "This is the projects page";

// Pagination setup
export async function getStaticPaths({ paginate }) {
  const { pageLength } = siteConfig;

  const allProjects = await getCollection("projects");
  return paginate(allProjects, { pageSize: pageLength });
}

// Get the current page data from Astro props
const { page } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="py-16">
    <header
      class="mx-auto flex max-w-screen-md flex-col items-center gap-6 mb-16 intersect:animate-delay-150 intersect:animate-fade-up intersect-once"
    >
      <h2 class="mb-4 text-center text-3xl font-semibold lg:text-5xl">
        Projects and Portfolio
      </h2>
      <p class="text-balance text-center text-gray-600 lg:text-xl">
        Browse through my featured projects showcasing my skills in frontend
        development, UX design, and creative problem-solving.
      </p>
    </header>

    <div class="grid grid-cols-4 gap-6 md:grid-cols-8 lg:grid-cols-12">
      {
        page.data.map((project, index) => (
          <div
            key={index}
            class={`col-span-4 intersect:animate-fade-up ${delayClasses[index % delayClasses.length]}  intersect-once`}
          >
            <ProjectCard
              data={project.data}
              url={slugify(project.data.title)}
            />
          </div>
        ))
      }
    </div>

    <!-- <nav class="flex justify-center gap-4 mt-8">
      {
        page.url.prev ? (
          <a
            href={page.url.prev}
            class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300"
          >
            Previous
          </a>
        ) : (
          <span class="px-4 py-2 text-gray-400">Previous</span>
        )
      }
      <span class="px-4 py-2">{page.currentPage} / {page.lastPage}</span>
      {
        page.url.next ? (
          <a
            href={page.url.next}
            class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300"
          >
            Next
          </a>
        ) : (
          <span class="px-4 py-2 text-gray-400">Next</span>
        )
      }
    </nav> -->

    <!-- Pagination Controls -->
    <nav class="flex justify-center gap-4 mt-12">
      {
        page.url.prev ? (
          <a
            href={page.url.prev}
            class="px-4 py-2 border rounded-lg hover:bg-gray-100 transition-colors"
          >
            &larr; Previous
          </a>
        ) : (
          <span class="px-4 py-2 text-gray-400">&larr; Previous</span>
        )
      }

      <span class="px-4 py-2">
        Page {page.currentPage} of {page.lastPage}
      </span>

      {
        page.url.next ? (
          <a
            href={page.url.next}
            class="px-4 py-2 border rounded-lg hover:bg-gray-100 transition-colors"
          >
            Next &rarr;
          </a>
        ) : (
          <span class="px-4 py-2 text-gray-400">Next &rarr;</span>
        )
      }
    </nav>
  </section>
</BaseLayout>
