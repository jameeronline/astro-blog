---
//astro imports
import { getCollection, getEntry } from "astro:content";

//components imports
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import PageHeader from "@blocks/PageHeader.astro";
import Paginate from "@components/Paginate.astro";

//utils imports
import { slugify } from "@utils/helper";

//site config
import { siteConfig } from "@config/siteconfig";

//page metadata
const title = "Projects Page";
const description = "This is the projects page";

// Pagination setup
export async function getStaticPaths({ paginate }) {
  const { pageLength } = siteConfig;

  const allProjects = await getCollection("projects");
  return paginate(allProjects, { pageSize: pageLength });
}

// Get the current page data from Astro props
const { page } = Astro.props;

// page header details
const pageHeader = {
  title: "Projects",
  caption: "Featured Works & Case Studies",
  description:
    "Browse through my featured projects showcasing my skills in frontend development, UX design, and creative problem-solving.",
};
---

<BaseLayout title={title} description={description}>
  <section>
    <PageHeader
      title={pageHeader.title}
      description={pageHeader.description}
      caption={pageHeader.caption}
    />

    <div
      class="grid grid-cols-4 gap-6 md:grid-cols-8 md:gap-12 lg:grid-cols-12"
    >
      {
        page.data.map((project) => (
          <div class="col-span-4" data-scroll-animate>
            <ProjectCard
              data={project.data}
              url={slugify(project.data.title)}
            />
          </div>
        ))
      }
    </div>

    <Paginate
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
    />
  </section>
</BaseLayout>
