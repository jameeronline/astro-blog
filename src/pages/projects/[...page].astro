---
//astro imports
import { getCollection, getEntry } from "astro:content";

//components imports
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import Paginate from "@components/Paginate.astro";

//utils imports
import { slugify } from "@utils/helper";

//site config
import { siteConfig } from "@config/siteconfig.ts";

const delayClasses = [
  "intersect:animate-delay-[0ms]",
  "intersect:animate-delay-[100ms]",
  "intersect:animate-delay-[200ms]",
  "intersect:animate-delay-[300ms]",
  "intersect:animate-delay-[400ms]",
  "intersect:animate-delay-[500ms]",
  "intersect:animate-delay-[600ms]",
  "intersect:animate-delay-[700ms]",
  "intersect:animate-delay-[800ms]",
  "intersect:animate-delay-[900ms]",
];

//page metadata
const title = "Projects Page";
const description = "This is the projects page";

// Pagination setup
export async function getStaticPaths({ paginate }) {
  const { pageLength } = siteConfig;

  const allProjects = await getCollection("projects");
  return paginate(allProjects, { pageSize: pageLength });
}

// Get the current page data from Astro props
const { page } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="py-16">
    <header
      class="mx-auto flex flex-col items-center text-center lg:max-w-3xl gap-6 mb-16 intersect:animate-delay-150 intersect:animate-fade-up intersect-once"
    >
      <h1 class="text-heading">Projects and Portfolio</h1>
      <p class="text-lead">
        Browse through my featured projects showcasing my skills in frontend
        development, UX design, and creative problem-solving.
      </p>
    </header>

    <div
      class="grid grid-cols-4 gap-6 md:grid-cols-8 md:gap-12 lg:grid-cols-12"
    >
      {
        page.data.map((project, index) => (
          <div
            key={index}
            class={`col-span-4 intersect:animate-fade-up ${delayClasses[index % delayClasses.length]}  intersect-once`}
          >
            <ProjectCard
              data={project.data}
              url={slugify(project.data.title)}
            />
          </div>
        ))
      }
    </div>

    <Paginate
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
    />
  </section>
</BaseLayout>
