---
//types
import type { CollectionEntry } from "astro:content";
import type { PaginateFunction } from "astro";
import type { PageProps } from "../../types/global";

//astro imports
import { getCollection, getEntry } from "astro:content";

//components imports
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import PageHeader from "@blocks/PageHeader.astro";
import Paginate from "@components/Paginate.astro";

//site config
import { siteConfig } from "@config/site-config";

// Pagination setup
export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const { pageLength } = siteConfig;

  const allProjects = await getCollection("projects");
  return paginate(allProjects, { pageSize: pageLength });
}

// Get the current page data from Astro props
const { page } = Astro.props;
//console.log(page);

// page header details
const pageHeader: PageProps = {
  title: "Featured Works & Case Studies",
  caption: "Recent Projects",
  description:
    "Browse through my featured projects showcasing my skills in frontend development, UX design, and creative problem-solving.",
};
---

<BaseLayout title={pageHeader.title} description={pageHeader.description}>
  <section>
    <PageHeader
      title={pageHeader.title}
      description={pageHeader.description}
      caption={pageHeader.caption}
    />

    <div
      class="grid grid-cols-4 gap-6 md:grid-cols-8 md:gap-12 lg:grid-cols-12"
    >
      {
        page.data.map((project) => (
          <div class="col-span-4" data-scroll-animate>
            <ProjectCard
              project={project}
            />
          </div>
        ))
      }
    </div>

    <Paginate
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
    />
  </section>
</BaseLayout>
