---
//astro imports
import { getCollection } from "astro:content";

//components imports
import BaseLayout from "@layouts/BaseLayout.astro";

//utils imports
import { slugify } from "@utils/helper";

export async function getStaticPaths() {
  const projectCollection = await getCollection("projects");

  return projectCollection.map((project) => ({
    params: { slug: slugify(project.data.title) },
    props: { title: project.data.title, projectid: project.id },
  }));
}

const { slug } = Astro.params;
const { title, projectid } = Astro.props;
---

<BaseLayout title="Project Details">
  <section>
    <h1 class="text-3xl font-bold underline text-emerald-600">
      Project Details {title}
    </h1>
    <p class="text-gray-700">
      This is the project details page. Here you can find more information about
      the project.
    </p>
    <!-- Add your project details here -->
  </section>
</BaseLayout>
