---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Get all posts
const posts = await getCollection("posts");

// Collect all unique tags
const tagsSet = new Set();
posts.forEach((post) => {
  if (Array.isArray(post.data.tags)) {
    post.data.tags.forEach((tag) => tagsSet.add(tag));
  }
});
const tags = Array.from(tagsSet).sort();
---

<BaseLayout pageTitle="All Tags">
  <h1 class="text-2xl font-bold mb-6">All Tags</h1>

  <div
    x-data={`{
    selected: 'all',
    tags: ['all', ...${JSON.stringify(tags)}],
    posts: ${JSON.stringify(posts)},
    get filteredPosts() {
        if (this.selected === 'all') return this.posts;
        return this.posts.filter(post => (post.data.tags || []).includes(this.selected));
    }
    }`}
    class="space-y-8"
  >
    <!-- Tag Filter Buttons -->
    <ul class="flex flex-wrap gap-2 mb-8">
      <template x-for="tag in tags" :key="tag">
        <li>
          <button
            type="button"
            :class="selected === tag
              ? 'bg-primary-900 text-white'
              : 'bg-mint text-navy hover:bg-primary-900 hover:text-white'"
            class="px-3 py-1 rounded transition"
            @click="selected = tag"
            x-text="tag.charAt(0).toUpperCase() + tag.slice(1)"></button>
        </li>
      </template>
    </ul>

    <!-- Blog List -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <template x-for="post in filteredPosts" :key="post.id">
        <div class="p-4 border rounded shadow">
          <a :href="`/posts/${post.id.replace(/^posts\\//, '')}/`">
            <h2 class="text-lg font-bold mb-2" x-text="post.data.title"></h2>
            <p class="text-sm text-gray-600" x-text="post.data.description"></p>
            <div class="mt-2 flex flex-wrap gap-1">
              <span
                class="px-2 py-0.5 text-xs rounded bg-gray-200"
                x-for="tag in post.data.tags"
                x-text="tag"></span>
            </div>
          </a>
        </div>
      </template>
      <template x-if="filteredPosts.length === 0">
        <div class="col-span-full text-center text-red-600 font-semibold py-8">
          No posts found for this tag.
        </div>
      </template>
    </div>
  </div>
</BaseLayout>
