---
import BaseLayout from "../../layouts/BaseLayout.astro";

import axios from "axios";

import { textToSlug } from "../../utils/helper";

let responseDataCategories = null;
let errorMessage = null;

try {
  const response = await axios.get(
    "https://www.themealdb.com/api/json/v1/1/list.php?c=list"
  );
  responseDataCategories = response.data;
} catch (error) {
  console.error("Error fetching data:", error);
  errorMessage = "Failed to load data. Please try again later.";
}

let responseDataAreas = null;

try {
  const responseAreas = await axios.get(
    "https://www.themealdb.com/api/json/v1/1/list.php?a=list"
  );
  responseDataAreas = responseAreas.data;
} catch (error) {
  console.error("Error fetching area data:", error);
  errorMessage = "Failed to load area data. Please try again later.";
}
---

<BaseLayout pageTitle="Dashboard">
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl font-bold mb-6">Recipes</h1>
      <div class="bg-white shadow-md rounded-lg p-6">
        <p class="text-gray-700">Welcome to your dashboard!</p>
        {
          responseDataCategories && responseDataCategories.meals && (
            <div class="areas-section mt-8">
              <h3 class="text-xl font-bold mb-4">Categories</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                {responseDataCategories.meals.map((meal) => (
                  <a
                    href={`/recipes/categories/${textToSlug(meal.strCategory)}`}
                    key={meal.strCategory}
                    class="col-span-1 relative bg-white rounded-lg shadow-md overflow-hidden"
                  >
                    <div class="p-4">
                      <h3 class="text-lg font-semibold">{meal.strCategory}</h3>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
