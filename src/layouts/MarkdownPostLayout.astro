---
import { Image } from "astro:assets";
const { frontmatter } = Astro.props;
import BaseLayout from "./BaseLayout.astro";
import BlogAside from "@blocks/BlogAside.astro";
import { format } from "date-fns";

const formattedDate = format(frontmatter.pubDate, "MM/dd/yyyy");
---

<BaseLayout title={frontmatter.title}>
  <section class="my-16">
    <div class="container px-6 m-auto">
      <div class="prose mb-8">
        <h1>{frontmatter.title}</h1>
      </div>
      <div class="grid grid-cols-4 gap-6 md:grid-cols-8 lg:grid-cols-12">
        <div class="col-span-4 lg:col-span-9">
          <article class="prose max-w-none">
            <figure>
              <Image
                src={frontmatter.image.url}
                alt={frontmatter.title}
                width={1600}
                height={900}
                class="w-full rounded-lg object-cover object-center"
              />
              <figcaption>{frontmatter.image.alt}</figcaption>
              <p class="text-sm">
                Written by {frontmatter.author} on {formattedDate}
              </p>
              <!-- <p>{frontmatter.description}</p> -->
            </figure>

            <slot />
          </article>
        </div>

        <div class="col-span-4 lg:col-span-3">
          <BlogAside />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
