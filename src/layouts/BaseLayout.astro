---
interface BaseLayoutProps {
  title?: string;
  description?: string;
}

// styles imports
import "@/styles/global.css";

//components imports
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import CTA from "@blocks/CTA.astro";
import CookieBanner from "@/components/CookieBanner.astro";

//fonts import
import "@fontsource-variable/outfit";

//scripts imports
import LocalScript from "@components/scripts/LocalScript.astro";

//site config imports
import { siteConfig } from "@config/siteconfig.ts";

//page meta data imports
const { title = siteConfig.title, description = siteConfig.description } = Astro.props;

import { ClientRouter } from "astro:transitions";
---

<html lang="en" class="h-full scroll-animation scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <!-- <ClientRouter /> -->
  </head>
  <body
    class="relative h-full font-sans text-gray-900 dark:bg-slate-900 dark:text-slate-50 bg-primary-50/50"
  >
    <div
      class="absolute inset-0 opacity-50 bg-no-repeat bg-contain bg-left-top -z-10"
      style="background-image: url('/bg-mash-gradient.svg');"
    >
    </div>
    <!-- dark overlay -->

    <div class="grid grid-cols-1 grid-rows-[auto_1fr_auto] h-full">
      <Header title={title} />
      <main class="w-full xl:container mx-auto px-4">
        <slot />
      </main>
      <!-- <CTA /> -->
      <Footer />
      <CookieBanner />
    </div>
    <LocalScript />
    <script>
      //   import "../scripts/menu.js";
      //   import "../scripts/vendor.js";
      import { Observer } from "tailwindcss-intersect";
      Observer.start();
    </script>
  </body>
</html>
