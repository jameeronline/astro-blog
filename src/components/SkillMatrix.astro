---
interface Skill {
  name: string;
  level: number; // 1-5
  category: "frontend" | "backend" | "tools" | "soft";
}

interface SkillsMatrixProps {
  skills: Skill[];
}

const categories = [
  { id: "all", name: "All Skills" },
  { id: "frontend", name: "Frontend" },
  { id: "backend", name: "Backend" },
  { id: "tools", name: "Tools" },
  { id: "soft", name: "Soft Skills" },
];

const { skills } = Astro.props as SkillsMatrixProps;
---

<div
  x-data={`{
    activeCategory: 'all',
    categories: ${JSON.stringify(categories)},
    skills: ${JSON.stringify(skills)},
    get filteredSkills() {
      if (this.activeCategory === 'all') return this.skills;
      return this.skills.filter(skill => skill.category === this.activeCategory);
    }
  }`}
  class="space-y-8"
>
  <!-- Category Filter Buttons -->
  <div class="flex flex-wrap gap-2" id="categories">
    <template x-for="category in categories" :key="category.id">
      <button
        type="button"
        :class="activeCategory === category.id
          ? 'bg-primary-900 text-white hover:bg-gray-400'
          : 'bg-mint text-navy'"
        class="px-4 py-2 text-sm rounded-full transition-all"
        @click="activeCategory = category.id"
        x-text="category.name"></button>
    </template>
  </div>

  <!-- Skills Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="skills">
    <template x-for="skill in filteredSkills" :key="skill.name">
      <div
        class="flex flex-col gap-4 rounded-lg border border-gray-100 bg-white p-8 animate-fade-up"
      >
        <div class="flex justify-between items-center mb-2">
          <h4 class="font-bold" x-text="skill.name"></h4>
          <span
            class="text-xs font-mono bg-gray-200 px-2 py-1 rounded-full"
            x-text="skill.category"></span>
        </div>
        <div class="w-full h-2 bg-gray-400/20 rounded-full overflow-hidden">
          <div
            class="h-full bg-primary-900/80 rounded-full transition-all duration-1000 ease-out"
            :style="`width: ${skill.level * 20}%`"
          >
          </div>
        </div>
        <div class="flex justify-between mt-1 text-xs text-muted-foreground">
          <span>Beginner</span>
          <span>Expert</span>
        </div>
      </div>
    </template>
    <template x-if="filteredSkills.length === 0">
      <div class="col-span-full text-center text-red-600 font-semibold py-8">
        No skills found for this category.
      </div>
    </template>
  </div>
</div>
