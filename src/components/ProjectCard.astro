---
//astro imports
import Image from "astro/components/Image.astro";
import { Icon } from "astro-icon/components";

//props
const { data, url = "#" } = Astro.props;
---

<article class="rounded-xl transition-all">
  <div class="relative overflow-hidden rounded-xl mb-8">
    <Image
      class="object-cover object-center w-full lg:h-48 md:h-36 bg-gray-50 transition duration-300 ease-in-out hover:scale-110"
      src={data.thumbnail}
      alt={data.title}
      layout="constrained"
      loading="lazy"
    />
  </div>

  <h3
    class="font-heading mb-8 text-2xl font-semibold leading-snug tracking-tighter text-gray-800 lg:text-3xl"
  >
    {data.title}
  </h3>
  <p class="mx-auto text-base leading-relaxed text-gray-600 line-clamp-3">
    {data.description}
  </p>

  <div class="mt-6 flex gap-4">
    {
      data.tags.map((tag) => (
        <span class="inline-block rounded-full bg-gray-200 px-2 py-0.5 text-sm text-gray-700 capitalize cursor-default">
          {tag}
        </span>
      ))
    }
  </div>

  <footer class="flex items-center justify-between mt-10">
    <a href={`/projects/${url}`} class="text-sm text-primary-800 underline"
      >View Details</a
    >
    <div class="flex items-center justify-between gap-4">
      <a
        href={data.github}
        class="w-10 h-10 inline-flex items-center justify-center rounded-full transition duration-300 bg-primary-100 hover:bg-gray-200"
      >
        <Icon
          name="github-line"
          class="w-6 h-6 text-gray-800 transition duration-300 hover:text-gray-900"
          aria-label="GitHub Repository"
        />
      </a>
      <a
        href={data.liveDemo}
        class="w-10 h-10 inline-flex items-center justify-center rounded-full transition duration-300 bg-secondary-100 hover:bg-gray-200"
      >
        <Icon
          name="external-link-line"
          class="w-6 h-6 text-gray-800 transition duration-300 hover:text-gray-900"
          aria-label="Live Demo"
        />
      </a>
    </div>
  </footer>
</article>
