---
import Image from "astro/components/Image.astro";
const { data, url = "#" } = Astro.props;

import Github from "../assets/icons/github-line.svg";
import LiveDemo from "../assets/icons/external-link-line.svg";
---

<article class="p-6 px-2 meal-card rounded-xl transition-all">
  <div class="relative overflow-hidden rounded-xl mb-8">
    <Image
      class="object-cover object-center w-full lg:h-48 md:h-36 bg-gray-50 transition duration-300 ease-in-out hover:scale-110"
      src={data.image}
      alt={data.title}
      format="webp"
      width={1600}
      height={900}
    />
  </div>

  <h1
    class="mx-auto mb-8 text-2xl font-semibold leading-snug tracking-tighter text-gray-800 lg:text-2xl meal-title"
  >
    {data.title}
  </h1>
  <p class="mx-auto text-base leading-relaxed text-gray-600 line-clamp-3">
    {data.description}
  </p>

  <div class="mt-6 flex gap-4">
    {
      data.tags.map((tag) => (
        <span class="inline-block rounded-full bg-gray-200 px-2 py-0.5 text-sm text-gray-700">
          {tag}
        </span>
      ))
    }
  </div>

  <footer class="flex items-center justify-between mt-10">
    <div class="flex items-center justify-between gap-4">
      <a
        href={data.github}
        class="w-10 h-10 inline-flex items-center justify-center rounded-full transition duration-300 hover:bg-gray-200"
        ><Github class="w-6 h-6" /></a
      >
      <a
        href={data.liveDemo}
        class="w-10 h-10 inline-flex items-center justify-center rounded-full transition duration-300 hover:bg-gray-200"
        ><LiveDemo class="w-6 h-6" /></a
      >
    </div>
    <a href={`/project/${url}`} class="text-sm text-primary-800 underline"
      >View Details</a
    >
  </footer>
</article>
