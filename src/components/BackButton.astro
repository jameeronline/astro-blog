---
import { ArrowLeft } from "@lucide/astro";
const { label, href } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center justify-center text-sm gap-2 text-primary-800 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-full py-2.5 mb-4 md:mb-8 dark:focus:ring-gray-700 dark:border-gray-700 no-underline"
>
  <ArrowLeft class="w-5 h-5" /> {label}</a
>
