---
import { ArrowLeft } from "@lucide/astro";

/**
 * BackButton Component
 * Props:
 * - label: string (button text)
 * - href: string (link destination)
 * - ...rest: any other props for <a>
 */

interface Props {
  label?: string;
  href?: string;
  [key: string]: any;
}

const { label = "Back", href = "#", ...rest } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center justify-center text-sm gap-2 text-gray-600 hover:text-primary-500 font-medium h-10 mb-4 dark:border-gray-700 hover:underline  transition-colors"
  {...rest}
>
  <ArrowLeft class="w-5 h-5" /> <span>{label}</span>
</a>
