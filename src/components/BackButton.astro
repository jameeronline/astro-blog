---
import { ArrowLeft } from "@lucide/astro";

/**
 * BackButton Component
 * Props:
 * - label: string (button text)
 * - href: string (link destination)
 * - ...rest: any other props for <a>
 */

interface BackButtonProps {
  label?: string;
  href?: string;
  [key: string]: any;
}

const { label = "Back", href = "#", ...rest } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center justify-center text-sm gap-2 text-gray-600 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium h-10 px-2 mb-4 md:mb-8 dark:focus:ring-gray-700 dark:border-gray-700 hover:underline hover:text-primary-500 transition-colors"
  {...rest}
>
  <ArrowLeft class="w-5 h-5" /> <span>{label}</span>
</a>
