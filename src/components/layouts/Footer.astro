---
import Social from "./Social.astro";

//astro imports
import { Icon } from "astro-icon/components";

//site config imports
import { siteConfig, socialLinks } from "@config/site-config";
const { title, description, year, logoText } = siteConfig;

const solutions = {
  title: "Solutions",
  items: [
    { name: "Marketing", href: "#" },
    { name: "Analytics", href: "#" },
    { name: "Commerce", href: "#" },
    { name: "Insights", href: "#" },
  ],
};

const support = {
  title: "Support",
  items: [
    { name: "Pricing", href: "#" },
    { name: "Documentation", href: "#" },
    { name: "Guides", href: "#" },
    { name: "API Status", href: "#" },
  ],
};
---

<footer class="text-gray-100 bg-primary-900 mt-4 md:mt-20">
  <div class="py-12 lg:py-16">
    <div class="w-full xl:container px-6 mx-auto">
      <div class="xl:grid xl:grid-cols-3 xl:gap-8">
        <div class="space-y-8 xl:col-span-1">
          <a
            href="#"
            class="text-3xl font-bold font-heading tracking-wide text-primary-50 transition duration-500 ease-in-out lg:pr-8"
          >
            {logoText}<span class="text-gray-50"></span>
          </a>
          <!-- <p class="mt-2 w-1/2 text-sm text-gray-100">
            {description}
          </p> -->
        </div>
        <div class="mt-12 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
          <div class="md:grid md:grid-cols-2 md:gap-8">
            <div>
              <h3
                class="text-xs font-semibold uppercase tracking-wider text-primary-100/60"
              >
                Solutions
              </h3>
              <ul role="list" class="mt-4 space-y-4">
                {
                  solutions.items.map((item, index) => (
                    <li>
                      <a
                        href={item.href}
                        class="text-sm font-normal text-gray-100 hover:text-gray-900"
                      >
                        {item.name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="mt-12 md:mt-0">
              <h3
                class="text-xs font-semibold uppercase tracking-wider text-primary-100/60"
              >
                Support
              </h3>
              <ul role="list" class="mt-4 space-y-4">
                {
                  support.items.map((item, index) => (
                    <li>
                      <a
                        href={item.href}
                        class="text-sm font-normal text-gray-100 hover:text-gray-900"
                      >
                        {item.name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div class="hidden md:grid md:grid-cols-1 lg:justify-end">
            <div class="mt-12 w-full md:mt-0">
              <div class="mt-8 lg:justify-end xl:mt-0">
                <h3
                  class="text-xs font-semibold uppercase tracking-wider text-primary-100/60"
                >
                  Subscribe to our newsletter
                </h3>
                <p class="mt-4 text-sm text-gray-100 lg:ml-auto">
                  The latest news, articles, and resources, sent to your inbox
                  weekly.
                </p>
                <div
                  class="inline-flex list-none items-center gap-2 lg:ml-auto"
                >
                  <form
                    action=""
                    method="post"
                    id="revue-form"
                    name="revue-form"
                    target="_blank"
                    class="border mt-4 rounded bg-gray-50 p-1 transition duration-500 ease-in-out sm:flex sm:max-w-lg"
                  >
                    <div class="min-w-0 flex-1">
                      <label for="member_email" class="sr-only"
                        >Email address</label
                      >
                      <input
                        id="cta-email"
                        type="email"
                        class="block w-full rounded outline-0 border-transparent bg-transparent px-6 h-12 text-base text-gray-600 transition duration-500 ease-in-out placeholder:text-gray-300 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-300"
                        placeholder="Enter your email  "
                      />
                    </div>
                    <div class="mt-4 sm:ml-3 sm:mt-0">
                      <button
                        type="submit"
                        value="Subscribe"
                        name="member[subscribe]"
                        id="member_submit"
                        class="block w-full rounded border border-transparent bg-secondary-600 px-4 h-full text-base font-medium text-white shadow hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-300"
                        >Notify me</button
                      >
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-primary-100 py-6">
    <div class="w-full xl:container px-6 mx-auto">
      <div class="md:flex md:items-center md:justify-between">
        <div class="mb-8 flex justify-center space-x-6 md:order-last md:mb-0">
          {
            socialLinks.map((link, index) => (
              <a
                href={link.href}
                class="text-primary-900 hover:text-primary-900 transition-colors duration-300"
                target="_blank"
              >
                <span class="sr-only">{link.alt}</span>
                <Icon name={link.icon} class="size-6" />
              </a>
            ))
          }
        </div>

        <div class="mt-8 md:order-1 md:mt-0">
          <span class="mt-2 text-sm font-semibold text-gray-800">
            Copyright © {year} - {year + 1}
            <a
              href="https://jameer.online"
              class="mx-1 text-primary-900 hover:text-blue-700">{title}</a
            >
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>