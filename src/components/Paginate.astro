---
export interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
---

<nav class="flex justify-center gap-2 mt-12">
  {
    prevUrl ? (
      <a
        href={prevUrl}
        class="px-4 py-2 border rounded-full hover:bg-gray-100 transition-colors"
      >
        &larr; Previous
      </a>
    ) : (
      <span class="px-4 py-2 text-gray-400">&larr; Previous</span>
    )
  }

  <span class="px-4 py-2">
    Page <span aria-live="polite" class="font-bold">{currentPage}</span> of <span aria-live="polite">{lastPage}</span>
  </span>

  {
    nextUrl ? (
      <a
        href={nextUrl}
        class="px-4 py-2 border rounded-full hover:bg-gray-100 transition-colors"
      >
        Next &rarr;
      </a>
    ) : (
      <span class="px-4 py-2 text-gray-400">Next &rarr;</span>
    )
  }
</nav>
