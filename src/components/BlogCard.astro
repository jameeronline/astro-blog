<a href={`/posts/${url}`}>
  <article
    class="p-6 px-2 meal-card rounded-xl transition-all hover:bg-white/10 hover:shadow-2xl"
  >
    <Image
      class="object-cover object-center w-full mb-8 lg:h-48 md:h-36 rounded-xl bg-gray-50"
      src={item.image.url}
      alt={item.title}
      format="webp"
      width={1600}
      height={900}
    />

    <h1
      class="mx-auto mb-8 text-2xl font-semibold leading-snug tracking-tighter text-gray-800 lg:text-2xl meal-title"
    >
      {item.title}
    </h1>
    <p class="mx-auto text-base leading-relaxed text-gray-600">
      {item.description}
    </p>

