---
//astro import
import Image from "astro/components/Image.astro";

//components import
import Badge from "./ui/Badge.astro";

// utils import
import { slugify } from "@utils/helper";

// Astro props
const { item, url = "#" } = Astro.props;

// get tags and categories from item
const tags = item.tags.map((tag: string) => tag.trim());
const categories = item.categories.map((category: string) => category.trim());
---

<article class="rounded-xl transition-all">
  <a href={`/blog/${url}`}>
    <div class="relative overflow-hidden bg-cover bg-no-repeat rounded-xl mb-8">
      <Image
        class="object-cover object-center w-full lg:h-48 md:h-36 bg-gray-50 transition duration-300 ease-in-out hover:scale-110"
        src={item.image.url}
        alt={item.title}
        format="webp"
        loading="lazy"
        width={1600}
        height={900}
      />
    </div>

    <h3
      class="mx-auto mb-8 text-2xl font-semibold leading-snug tracking-tighter text-gray-800 lg:text-2xl meal-title"
    >
      {item.title}
    </h3>
    <p class="mx-auto text-base leading-relaxed text-gray-600 line-clamp-3">
      {item.description}
    </p>
  </a>

  <div class="mt-6 flex gap-4">
    {
      categories.map((category: string, index: number) => (
        <Badge
          key={index}
          label={category}
          href={`/blog/category/${slugify(category)}`}
          class="capitalize"
        />
      ))
    }
  </div>
</article>
