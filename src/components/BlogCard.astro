---
//astro import
import { Image } from "astro:assets";
import { getEntry, getEntries } from "astro:content";

import type { CollectionEntry } from "astro:content";

interface Props {
  item: CollectionEntry<"posts">;
  url?: string;
}

// Astro props
const { item, url = "#" } = Astro.props;

const styles = {
  container: "rounded-xl transition-all",
  imageWrapper:
    "relative overflow-hidden bg-cover bg-no-repeat rounded-xl mb-8",
  image:
    "object-cover object-center w-full aspect-video bg-gray-200 transition duration-300 ease-in-out hover:scale-110 dark:bg-transparent",
  title:
    "mb-8 text-2xl lg:text-3xl font-semibold font-heading leading-snug tracking-tighter text-slate-800 dark:text-slate-100 hover:text-primary-800 transition-colors duration-300",
  description:
    "text-base leading-relaxed text-slate-600 line-clamp-3 dark:text-slate-400",
  categoryBadgeWrapper: "mt-6 flex gap-4",
  categoryItem: "capitalize text-sm inline-flex rounded-full",
};

//data from item
const { data } = item;

// get tags and categories from item
const tags = data.tags.map((tag: string) => tag.trim());
const categories = await getEntries(data?.categories);
---

<article class={styles.container}>
  <a href={`/blog/${url}`} aria-label={`Read more about ${data.title}`}>
    <div class={styles.imageWrapper}>
      {
        data.image ? (
          <Image
            class={styles.image}
            src={data.image?.url}
            alt={data.image?.alt}
            layout="constrained"
            loading="lazy"
            inferSize
          />
        ) : (
          <Image
            class={styles.image}
            src="/blog-fallback.png"
            alt={"Blog post image fallback"}
            layout="constrained"
            loading="lazy"
            width={500}
            height={500}
          />
        )
      }
    </div>

    <h3 class={styles.title}>
      {data.title}
    </h3>
    <p class={styles.description}>
      {data.description}
    </p>
  </a>

  <div class={styles.categoryBadgeWrapper}>
    {
      categories.map(({ data }) => (
        <a href={`/blog/category/${data?.slug}`} class={styles.categoryItem}>
          {data?.title}
        </a>
      ))
    }
  </div>
</article>
