---
//astro import
import Image from "astro/components/Image.astro";

//components import
import Badge from "./ui/Badge.astro";

// utils import
import { slugify } from "@utils/helper";

// Astro props
const { item, url = "#" } = Astro.props;

// get tags and categories from item
const tags = item.tags.map((tag: string) => tag.trim());
const categories = item.categories.map((category: string) => category.trim());
---

<article class="rounded-xl transition-all">
  <a href={`/blog/${url}`} aria-label={`Read more about ${item.title}`}>
    <div class="relative overflow-hidden bg-cover bg-no-repeat rounded-xl mb-8">
      <Image
        class="object-cover object-center w-full lg:h-48 md:h-36 bg-slate-50 transition duration-300 ease-in-out hover:scale-110 dark:bg-transparent"
        src={item.image.url}
        alt={item.title}
        layout="constrained"
        loading="lazy"
      />
    </div>

    <h3
      class="mb-8 text-2xl lg:text-3xl font-semibold font-heading leading-snug tracking-tighter text-slate-800 dark:text-slate-100 hover:text-primary-700 transition-colors duration-300"
    >
      {item.title}
    </h3>
    <p
      class="text-base leading-relaxed text-slate-600 line-clamp-3 dark:text-slate-400"
    >
      {item.description}
    </p>
  </a>

  <div class="mt-6 flex gap-4">
    {
      categories.map((category: string, index: number) => (
        <Badge
          key={index}
          label={category}
          href={`/blog/category/${slugify(category)}`}
          class="capitalize"
        />
      ))
    }
  </div>
</article>
