---
//astro imports
import { Image } from "astro:assets";

//utils imports
import { formatDate } from "@utils/helper";

//props
const { post, url, ...rest } = Astro.props;
const { title, image, pubDate } = post.data;
---

<div class="col-span-4 lg:col-span-6" {...rest}>
  <div class="group sm:flex lg:items-start">
    <div class="mb-4 shrink-0 sm:mb-0 sm:mr-4">
      <Image
        class="w-full rounded-md object-cover sm:size-32"
        src={image.url}
        alt={title}
        format="webp"
        loading="lazy"
        width={1600}
        height={900}
      />
    </div>
    <div>
      <span class="text-sm text-gray-500">{formatDate(pubDate)}</span>
      <p class="mt-3 text-lg font-medium leading-6">
        <a
          href={`/blog/${url}`}
          class="text-xl text-gray-800 hover:underline transition-all duration-300"
          >{title}
        </a>
      </p>
    </div>
  </div>
</div>
