---
import { Image } from "astro:assets";
import { format } from "date-fns";

const { post, url } = Astro.props;
const { title, description, image, pubDate } = post.data;

//data transformation
const formattedDate = format(pubDate, "MMM d, yyyy");
---

<div class="col-span-4 lg:col-span-6">
  <div class="group sm:flex lg:items-start">
    <div class="mb-4 shrink-0 sm:mb-0 sm:mr-4">
      <Image
        class="w-full rounded-md object-cover sm:size-32"
        src={image.url}
        alt={title}
        format="webp"
        loading="lazy"
        width={1600}
        height={900}
      />
    </div>
    <div>
      <span class="text-sm text-gray-500">{formattedDate}</span>
      <p class="mt-3 text-lg font-medium leading-6">
        <a
          href={`/blog/${url}`}
          class="text-xl text-gray-800 hover:text-gray-500"
          >{title}
        </a>
      </p>
      <!-- <p class="text mt-2 leading-normal text-gray-500">
      {description}
    </p> -->
    </div>
  </div>
</div>
