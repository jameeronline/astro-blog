---
//icon
import ThemeIcon from "./ThemeIcon.astro";

//icons
import { Search } from "@lucide/astro";

//load data
import { navigation, siteConfig } from "@config/siteconfig.ts";

//site config
const { title, logoText, description, logo, onlyLogo } = siteConfig;
---

<!-- Component: Basic Navbar -->
<header
  x-data="{open: false}"
  class="sticky top-0 mb-10 lg:mb-20 z-20 w-full border-b shadow-lg border-slate-200 bg-white/90 dark:bg-transparent dark:border-0 shadow-slate-700/5 md:bg-transparent md:shadow-none md:border-0 after:absolute after:top-full after:left-0 after:z-10 after:block after:h-px after:w-full after:bg-slate-200 lg:border-slate-200 lg:backdrop-blur-3xl lg:after:hidden"
>
  <div class="relative w-full xl:container mx-auto px-4">
    <nav
      aria-label="main navigation"
      class="flex h-[5.5rem] items-stretch justify-between font-medium text-slate-700"
      role="navigation"
    >
      <!-- Brand logo -->
      <a
        id={title}
        aria-label="Zami Home"
        aria-current="page"
        class="flex items-center gap-2 py-3 text-2xl md:text-3xl font-semibold whitespace-nowrap focus:outline-none"
        href="/"
      >
        {
          onlyLogo ? (
            <img src={logo} alt="Logo" class="h-8 w-auto" />
          ) : (
            <span class="font-heading"><span class="text-primary-700">{logoText || "crewind"}</span>.ai</span>
          )
        }
      </a>
      <!-- Navigation links -->
      <ul
        role="menubar"
        aria-label="Select page"
        class="absolute top-0 left-0 z-[-1] ml-auto h-screen w-full justify-center overflow-hidden overflow-y-auto overscroll-contain bg-white/90 px-8 pb-12 pt-28 font-medium opacity-0 transition-[opacity,visibility] duration-300 lg:relative lg:top-0 lg:z-0 lg:flex lg:h-full lg:w-auto lg:items-stretch lg:overflow-visible lg:bg-white/0 lg:px-0 lg:py-0 lg:pt-0 lg:mr-10 lg:opacity-100"
        :class="{ 'opacity-100': open, 'opacity-0 hidden': !open }"
      >
        {
          navigation.map((item) => (
            <li role="none" class="flex items-stretch">
              <a
                role="menuitem"
                aria-current={item.current ? "page" : undefined}
                aria-haspopup="false"
                href={item.href}
                class={`flex items-center gap-2 font-semibold py-4 transition-colors duration-300 hover:text-primary-900 focus:text-primary-950 focus:outline-none focus-visible:outline-none lg:px-4 ${Astro.url.pathname === item.href ? "text-primary-900 underline underline-offset-4" : ""}`}
              >
                {item.icon ? <item.icon /> : <span>{item.name}</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex items-center gap-1 md:gap-2">
        <!-- Search link -->
        <a href="/search" class="size-10 inline-flex items-center justify-center"><Search class="w-6 h-6" /></a>

        <!-- Theme Toggle -->
        <ThemeIcon class="hidden lg:block" />

        <!-- contact link -->
        <a href="#" class="text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-4 lg:px-5 py-2 lg:py-2.5 mr-2 dark:bg-primary-600 dark:hover:bg-primary-700 focus:outline-none dark:focus:ring-primary-800">Get in Touch</a>

        <!-- Mobile trigger -->
        <button
          class="relative self-center order-10 visible block w-10 h-10 opacity-100 lg:hidden"
          aria-expanded="false"
          aria-label="Toggle navigation"
          type="button"
          aria-controls="navbar"
          @click="open = !open"
          :aria-expanded="open.toString()"
          :class="{ 'visible opacity-100 [&_span:nth-child(1)]:w-6 [&_span:nth-child(1)]:translate-y-0 [&_span:nth-child(1)]:rotate-45 [&_span:nth-child(2)]:-rotate-45 [&_span:nth-child(3)]:w-0 ': open, '': !open }"
        >
          <div
            class="absolute w-6 transform -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
          >
            <span
              aria-hidden="true"
              class="absolute block h-0.5 w-9/12 -translate-y-2 transform rounded-full bg-slate-900 transition-all duration-300"
            ></span>
            <span
              aria-hidden="true"
              class="absolute block h-0.5 w-6 transform rounded-full bg-slate-900 transition duration-300"
            ></span>
            <span
              aria-hidden="true"
              class="absolute block h-0.5 w-1/2 origin-top-left translate-y-2 transform rounded-full bg-slate-900 transition-all duration-300"
            ></span>
          </div>
        </button>
      </div>
    </nav>
  </div>
</header>
<!-- End Basic Navbar-->

