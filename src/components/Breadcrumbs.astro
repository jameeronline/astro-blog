---
// Components
import { Icon } from "astro-icon/components";

//import icons
import { ChevronLeft, HomeIcon } from "@lucide/astro";

// URL Parsing and breadcrumb generation
const url = new URL(Astro.request.url);
const pathname = url.pathname;
const segments = pathname.split("/").filter(Boolean);
const breadcrumbs = ["Home", ...segments];

// Props
type Props = {
  classes?: string;
};

const { classes } = Astro.props;

// Styles
const styles = {
  breadcrumbs:
    "inline-flex text-sm text-neutral-500 dark:text-neutral-300 mb-4",
  list: "inline-flex items-center gap-1",
  listItem:
    "flex items-center gap-2 [&:not(:first-child):not(:last-child)]:hidden [&:not(:first-child):not(:last-child)]:md:flex",
  itemLink:
    "flex items-center gap-1 truncate whitespace-nowrap capitalize text-neutral-700 transition-colors last:pointer-events-none last:text-primary-800 last:underline last:font-bold hover:text-primary-500 dark:text-neutral-50",
  itemIcon:
    "h-4 w-4 flex-none text-neutral-700 transition-transform md:rotate-180 dark:text-neutral-50",
};
---

<nav
  aria-label="Breadcrumb"
  class:list={[styles.breadcrumbs, { [`${classes}`]: classes }]}
>
  <ol class={styles.list}>
    {
      breadcrumbs.map((segment, index) => (
        <li class={styles.listItem}>
          <a
            href={`/${segments.slice(0, index).join("/")}`}
            class={styles.itemLink}
          >
            {index === 0 ? (
              <HomeIcon class="h-4 w-4" />
            ) : (
              segment.replace(/-/g, " ")
            )}
          </a>
          {index < breadcrumbs.length - 1 && (
            <ChevronLeft class={styles.itemIcon} />
          )}
        </li>
      ))
    }
  </ol>
</nav>
