---
const COOKIE_NAME = "cookie_consent";

import { cookieBannerData } from "@/data/theme.ts";

const {
  message,
  acceptAllText,
  managePreferencesText,
  privacyPolicyText,
  privacyPolicyUrl,
} = cookieBannerData;

const styles = {
  container:
    "fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white px-8 py-5 rounded-xl shadow-lg z-[1000] max-w-[90vw] text-base flex items-center gap-6 hidden",
  message: "",
  button:
    "bg-primary-600 text-white border-none px-5 py-2 rounded-lg cursor-pointer font-bold transition-colors duration-200 hover:bg-primary-500 whitespace-nowrap",
  manageButton:
    "bg-gray-700 text-white border-none px-5 py-2 rounded-lg cursor-pointer font-bold transition-colors duration-200 hover:bg-gray-800",
  link: "text-primary-400 underline",
};
---

<div id="cookie-banner" class={styles.container}>
  <span>
    {message}
    <a href={privacyPolicyUrl} class={styles.link}>{privacyPolicyText}</a>.
  </span>
  <button id="accept-cookies" class={styles.button}>
    {acceptAllText}
  </button>
  <button class={styles.manageButton}>
    {managePreferencesText}
  </button>
</div>

<script>
  const COOKIE_NAME = "cookie_consent";
  const banner = document.getElementById("cookie-banner");
  const button = document.getElementById("accept-cookies");

  if (banner && !localStorage.getItem(COOKIE_NAME)) {
    banner.style.display = "flex";
  }

  button?.addEventListener("click", () => {
    localStorage.setItem(COOKIE_NAME, "accepted");
    if (banner) {
      banner.style.display = "none";
    }
  });
</script>
