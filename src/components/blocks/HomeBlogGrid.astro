---
//icon imports
import { ArrowRightIcon, MoveRight } from "@lucide/astro";

//components imports
import BlogCard from "../components/BlogCard.astro";

// Astro imports
import { getCollection, getEntry, render } from "astro:content";

//utilities
import { slugify } from "../utils/helper";

const posts = (await getCollection("posts"))
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 3);
---

<section class="py-16">
  <div class="text-center mx-auto lg:max-w-3xl mb-16" data-scroll-animate>
    <p class="text-caption mb-4">Recent Blogs</p>
    <h2 class="text-subheading">Blog Posts</h2>
    <p class="mb-8 text-gray-700 mx-auto md:text-base lg:max-w-2xl lg:text-lg">
      Check out our latest articles, tips, and insights on web development,
      design, and technology trends.
    </p>
  </div>
  <div
    class="grid grid-cols-4 gap-6 md:grid-cols-8 md:gap-12 lg:grid-cols-12"
    data-scroll-animate
  >
    {
      posts.map(({ data }, index) => (
        <div
          key={index}
          class="col-span-4 intersect:animate-fade-up intersect-once"
        >
          <BlogCard item={data} url={slugify(data.title)} />
        </div>
      ))
    }
  </div>
  <footer class="flex justify-center mt-16">
    <a
      href="/blog"
      class="inline-flex items-center justify-center whitespace-nowrap rounded-md underline font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 text-gray-600 underline-offset-4 h-10 px-4 py-2 w-full sm:w-auto"
    >
      Explore all Posts
      <MoveRight class="ml-2 h-4 w-4" />
    </a>
  </footer>
</section>
