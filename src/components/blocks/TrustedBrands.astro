---
const brands = [
  { name: "Astro", icon: "/images/placeholders/logos/astro.svg" },
  { name: "Figma", icon: "/images/placeholders/logos/figma.svg" },
  { name: "Next.js", icon: "/images/placeholders/logos/nextjs.svg" },
  { name: "React", icon: "/images/placeholders/logos/react.png" },
  { name: "Figma", icon: "/images/placeholders/logos/figma.svg" },
  { name: "Supabase", icon: "/images/placeholders/logos/supabase.svg" },
  { name: "Tailwind", icon: "/images/placeholders/logos/tailwind.svg" },
  { name: "Vercel", icon: "/images/placeholders/logos/vercel.svg" },
];
---

<section class="py-32">
  <div class="container flex flex-col items-center text-center">
    <h1 class="my-6 text-pretty text-2xl font-bold lg:text-4xl">
      Trusted by these companies
    </h1>
  </div>
  <div class="pt-10 md:pt-16 lg:pt-20">
    <div class="relative mx-auto flex items-center justify-center lg:max-w-5xl">
      <div class="relative" role="region" aria-roledescription="carousel">
        <div class="overflow-hidden">
          <div class="flex ml-0">
            {
              brands.map((brand, index) => (
                <div
                  role="group"
                  aria-roledescription="slide"
                  class={`min-w-0 shrink-0 grow-0 basis-1/3 pl-0 sm:basis-1/4 md:basis-1/5 lg:basis-1/6 ${index === 0 ? "pl-10" : ""}`}
                >
                  <div class="mx-10 flex shrink-0 items-center justify-center">
                    <div>
                      <img
                        src={brand.icon}
                        alt={`Logo ${index + 1}`}
                        class="h-7 w-auto"
                      />
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
      <div
        class="absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-background to-transparent"
      >
      </div>
      <div
        class="absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-background to-transparent"
      >
      </div>
    </div>
  </div>
</section>
