---
import { Image } from "astro:assets";
import gallery1 from "@assets/gallery-1.jpg";
import gallery2 from "@assets/gallery-2.jpg";
import gallery3 from "@assets/gallery-3.jpg";

interface GalleryItem {
  image: ImageMetadata;
  title: string;
  description: string;
}

const galleryData = [
    {
        image: gallery1,
        title: "Stunning Visuals",
        description: "Experience breathtaking visuals with our expertly crafted designs.",
    },
    {
        image: gallery2,
        title: "Optimized Performance",
        description: "Our solutions ensure fast loading times and seamless user experiences.",
    },
    {
        image: gallery3,
        title: "Innovative Solutions",
        description: "We deliver cutting-edge solutions tailored to your business goals.",
    },
    {
        image: gallery1,
        title: "Responsive Design",
        description: "We create websites that look great on all devices.",
    },
    {
        image: gallery2,
        title: "SEO Optimization",
        description: "Our services ensure your website ranks higher in search engines.",
    },
    {
        image: gallery3,
        title: "Custom Development",
        description: "Tailored solutions to meet your unique business needs.",
    }
];
---

<section class="py-32">
    <div class="container">
      <div class="mb-8 flex flex-col justify-between md:mb-14 md:flex-row md:items-end lg:mb-16">
        <div>
          <p class="mb-6 text-xs font-medium uppercase tracking-wider">Tag Line</p>
          <h2 class="mb-3 text-xl font-semibold md:mb-4 md:text-4xl lg:mb-6">Gallery</h2>
          <a href="#" class="group flex items-center text-xs font-medium md:text-base lg:text-lg">Book a demo<!-- -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="lucide lucide-arrow-right ml-2 size-4 transition-transform group-hover:translate-x-1">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg></a>
        </div>
        <div class="mt-8 flex shrink-0 items-center justify-center gap-2">
          <button
            class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 w-10 disabled:pointer-events-auto"
            disabled="">
            <i class="ri-arrow-left-line text-2xl"></i>
            </button>
            <button
            class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 w-10 disabled:pointer-events-auto"
            disabled="">
            <i class="ri-arrow-right-line text-2xl"></i>
          </button>
        </div>
      </div>
    </div>
    <div class="w-full">
      <div class="relative" role="region" aria-roledescription="carousel">
        <div class="overflow-hidden">
          <div class="flex ml-[calc(p-4-20px)] mr-[calc(p-4)] 2xl:ml-[calc(50vw-700px+p-4-20px)] 2xl:mr-[calc(50vw-700px+p-4)]">
            {
                galleryData.map((item, index) => (
                    <div key={index} class="min-w-0 shrink-0 grow-0 basis-full pl-[20px] md:max-w-[452px]">
                        <a href="#" class="group flex flex-col justify-between">
                            <div>
                                <div class="flex aspect-[3/2] text-clip rounded-xl">
                                    <div class="flex-1">
                                        <div class="relative size-full origin-bottom transition duration-300 group-hover:scale-105">
                                            <Image src={item.image} alt={item.title} width={900} height={600}
                                                class="size-full object-cover object-center aspect-video" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div
                            class="mb-2 line-clamp-3 break-words pt-4 text-lg font-medium md:mb-3 md:pt-4 md:text-xl lg:pt-4 lg:text-2xl">
                              {item.title}
                            </div>
                            <div class="mb-8 line-clamp-2 text-sm text-gray-600 md:mb-12 md:text-base lg:mb-9">
                              {item.description}
                            </div>
                            
                            <div class="flex items-center gap-2 transition-colors hover:text-primary-800">
                              Read more <i class="ri-arrow-right-line text-2xl"></i>
                            </div>
                        </a>
                    </div>
            ))
          </div>
        </div>
      </div>
    </div>
  </section>