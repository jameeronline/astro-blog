---
interface ButtonProps {
  type?: "button" | "submit" | "reset";
  size?: "sm" | "md" | "lg";
  variant?: "primary" | "secondary" | "outline" | "link";
  as?: "button" | "a";
  href?: string;
  [key: string]: any;
}

const {
  type = "button",
  size = "md",
  variant = "primary",
  as = "button",
  href,
  ...props
} = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center rounded-lg text-base font-medium text-center focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-200";

const sizeClasses = {
  sm: "px-2 h-8 text-sm",
  md: "px-4 h-10 text-base",
  lg: "px-6 h-14 text-base",
};

const variantClasses = {
  primary:
    "bg-primary text-white hover:bg-primary-darker focus:ring-primary-dark",
  secondary: "bg-typo text-white hover:bg-gray-800 focus:ring-seconadary-dark",
  outline:
    "border border-primary text-primary bg-transparent hover:bg-primary-50 focus:ring-primary",
  link: "bg-transparent text-primary underline hover:text-primary-800 focus:ring-primary",
};

const classes = `${baseClasses} ${sizeClasses[size] ?? sizeClasses.md} ${variantClasses[variant] ?? variantClasses.primary}`;
---

{as === "a" ? (
  <a href={href} class={classes} {...props}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...props}>
    <slot />
  </button>
)}
