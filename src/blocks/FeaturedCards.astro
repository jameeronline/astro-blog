---
const header = "Build your own website with our UI blocks";
const featuredCards = [
  {
    title: 'Quality',
    description:
      'Our UI blocks are designed with quality in mind. We make sure that every block is pixel perfect and visually appealing.',
    icon: 'ri-zoom-in-line',
  },
  {
    title: 'Customizable',
    description:
      'You can easily customize our UI blocks to fit your needs. Change colors, fonts, and more with our easy-to-use interface.',
    icon: 'ri-grid-fill',
  },
  {
    title: 'Responsive',
    description:
      'Our UI blocks are fully responsive and look great on any device. No matter the screen size, your website will look amazing.',
    icon: 'ri-macbook-line',
  },
  {
      title: 'Easy to Use',
      description:
          'Our UI blocks are easy to use and require no coding knowledge. Simply drag and drop the blocks you want and you are good to go.',
      icon: 'ri-dropdown-list',
  },
  {
      title: 'Fast',
      description:
          'Our UI blocks are optimized for speed and performance. Your website will load fast and provide a great user experience.',
      icon: 'ri-flashlight-line',
  },
  {
      title: 'Modern',
      description:
          'Our UI blocks are designed with modern trends in mind. Your website will look fresh and up-to-date with our blocks.',
      icon: 'ri-info-card-fill',
  }
];
---

<section
  class="relative py-16 before:absolute before:inset-0 before:bg-zinc-900/10 before:[mask-image:url(/images/placeholders/minima/waves.svg)] before:[mask-repeat:repeat] before:[mask-size:_64px_32px]">
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent to-background">
  </div>
  <div class="container relative">
    <h2 class="mb-16 max-w-screen-sm text-balance mx-auto text-center text-2xl font-bold lg:text-5xl">
      {header}
    </h2>
    <div class="z-30 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredCards.map(item => (
          <div class="flex flex-col gap-10 rounded-lg border border-gray-100 bg-white p-8">
            <div>
              <i class={`${item.icon} text-2xl inline-flex mb-4`}></i>
              <h3 class="mb-2 text-xl font-bold">{item.title}</h3>
              <p class="text-gray-600">{item.description}
              </p>
            </div>
            <a href="#" class="flex items-center gap-2 font-medium underline text-primary-800">Learn more</a>
          </div>
        ))
      }
    </div>
  </div>
</section>