---
interface Props {
  title: string;
  description?: string;
  caption?: string;
}
const { title, description, caption }: Props = Astro.props;
---

<header
  class="mx-auto flex flex-col items-center text-center lg:max-w-4xl gap-6 mb-10 md:mb-20"
  data-scroll-animate
>
  <div class="flex flex-col gap-2">
    <p class="text-caption" data-scroll-animate>{caption}</p>
    <h1 class="mb-0 text-heading" data-scroll-animate>{title}</h1>
  </div>
  <p class="text-lead" data-scroll-animate>
    {description}
  </p>
</header>
