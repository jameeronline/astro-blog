    role: 'Frontend Engineer',
    image: 'https://images.unsplash.com/photo-1465101046530-73398c7f28ca?auto=format&fit=crop&w=1180&q=80',
    text: 'WickedBlocks has elevated the quality of our UI. The components are modern and easy to use.'
  },
  {
    name: 'Liam Johnson',
    role: 'DevOps Engineer',
    image: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=1180&q=80',
