          ></path>
        </svg>
      </button>
    </div> -->

    <div class="embla__dots w-full"></div>
  </div>
</section>

<script>
  import EmblaCarousel from "embla-carousel";
  import { addPrevNextBtnsClickHandlers } from "../assets/js/EmblaCarouselArrowButtons";
  import { addDotBtnsAndClickHandlers } from "../assets/js/EmblaCarouselDotButton";
  import Autoplay from "embla-carousel-autoplay";

  const OPTIONS = { dragFree: true, loop: true };

  const slider = document.querySelector(".embla");
  const viewportNode = slider.querySelector(".embla__viewport");
  // const prevBtnNode = slider.querySelector(".embla__button--prev");
  // const nextBtnNode = slider.querySelector(".embla__button--next");
  const dotsNode = slider.querySelector(".embla__dots");

  const emblaApi = EmblaCarousel(viewportNode, OPTIONS, [Autoplay()]);

  const onNavButtonClick = (emblaApi) => {
    const autoplay = emblaApi?.plugins()?.autoplay;
    if (!autoplay) return;

    const resetOrStop =
      autoplay.options.stopOnInteraction === false
        ? autoplay.reset
        : autoplay.stop;

    resetOrStop();
  };

  // const removePrevNextBtnsClickHandlers = addPrevNextBtnsClickHandlers(
  //   emblaApi,
  //   prevBtnNode,
  //   nextBtnNode,
  //   onNavButtonClick
  // );
  const removeDotBtnsAndClickHandlers = addDotBtnsAndClickHandlers(
    emblaApi,
    dotsNode,
    onNavButtonClick
  );

  // emblaApi.on("destroy", removePrevNextBtnsClickHandlers);
  emblaApi.on("destroy", removeDotBtnsAndClickHandlers);
</script>
