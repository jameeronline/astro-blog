---
//astro imports
import { Icon } from "astro-icon/components";

//component imports
import Badge from "@components/ui/Badge.astro";

//utils import
import { slugify } from "@utils/helper";

//props
const { headings, tags, categories } = Astro.props;
---

<aside class="top-20 mb-8 w-full self-start md:sticky shadow-2xl/10">
  <div class="mb-8 flex w-full max-w-fit shrink-0 flex-col md:mb-10 hidden">
    <div class="hidden w-full md:mt-1 md:block">
      <div class="flex w-full items-center space-x-6">
        <a href="#" class="hover:-translate-y-0.5 transition-all duration-300">
          <Icon name="brands/instagram" class="size-6 text-primary-800" />
        </a>
        <a href="#" class="hover:-translate-y-0.5 transition-all duration-300"
          ><Icon name="brands/linkedin" class="size-6" /></a
        ><a href="#" class="hover:-translate-y-0.5 transition-all duration-300"
          ><Icon name="brands/x" class="size-6" /></a
        ><a href="#" class="hover:-translate-y-0.5 transition-all duration-300"
          ><Icon name="brands/dribbble" class="size-6" /></a
        >
      </div>
    </div>
  </div>
  <div
    class="flex flex-col rounded-xl border border-gray-100 bg-white py-6 md:py-8"
  >
    <div class="mb-6 px-6 last:mb-0">
      {
        headings && headings.length > 0 && (
          <nav>
            <div class="md:mb-4.5 mb-6 font-bold leading-5">Overview</div>

            <ul class="space-y-3" id="blog-toc">
              {headings
                .filter((h) => h.depth === 2 || h.depth === 3)
                .map((h) => (
                  <li class={`ml-${(h.depth - 2) * 4}`}>
                    <a
                      href={`#${h.slug ?? h.id}`}
                      class="text-sm text-gray-600 hover:text-primary-900 transition-colors toc-link"
                      data-toc-id={h.slug ?? h.id}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
            </ul>
          </nav>
        )
      }
    </div>
    <!-- <div class="mb-6 px-6 last:mb-0">
      <div class="mb-2 font-bold">Categories</div>
      <div class="flex items-center flex-wrap gap-2">
        {
          categories.map((category, index) => (
            <Badge
              key={index}
              label={category}
              href={`/blog/category/${slugify(category)}`}
            />
          ))
        }
      </div>
    </div> -->
    <div class="mb-6 px-6 last:mb-0">
      <div class="mb-2 font-bold">Tags</div>
      <div class="flex items-center flex-wrap gap-2">
        {
          tags.map((tag, index) => (
            <a
              href={`/blog/tags/${slugify(tag)}`}
              class="text-sm underline hover:text-primary-900 transition-colors"
              key={index}
            >
              #{tag}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</aside>

<script type="module" is:inline>
  // Smooth scroll for TOC links
  document.querySelectorAll(".toc-link").forEach((link) => {
    link.addEventListener("click", function (e) {
      const targetId = link.getAttribute("data-toc-id");
      const target = document.getElementById(targetId);
      if (target) {
        e.preventDefault();
        window.scrollTo({
          top: target.getBoundingClientRect().top + window.scrollY - 80, // adjust offset as needed
          behavior: "smooth",
        });
      }
    });
  });

  // Scrollspy functionality
  const tocLinks = Array.from(document.querySelectorAll(".toc-link"));
  const headingElements = tocLinks
    .map((link) => document.getElementById(link.getAttribute("data-toc-id")))
    .filter(Boolean);

  function activateLink(id) {
    tocLinks.forEach((link) => {
      if (link.getAttribute("data-toc-id") === id) {
        link.classList.add("text-primary-900", "font-bold");
      } else {
        link.classList.remove("text-primary-900", "font-bold");
      }
    });
  }

  function onScroll() {
    let activeId = null;
    for (let i = headingElements.length - 1; i >= 0; i--) {
      const heading = headingElements[i];
      if (heading.getBoundingClientRect().top <= 90) {
        // adjust offset as needed
        activeId = heading.id;
        break;
      }
    }
    if (activeId) activateLink(activeId);
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  // Initial activation
  onScroll();
</script>
