---
//component imports
import Badge from "@components/ui/Badge.astro";

//utils import
import { slugify } from "@utils/helper";

//props
const { headings, tags, categories } = Astro.props;

const socialLinks = [
  {
    href: "#",
    src: "/images/placeholders/logos/instagram-icon.svg",
    alt: "Instagram",
  },
  {
    href: "#",
    src: "/images/placeholders/logos/linkedin-icon.svg",
    alt: "LinkedIn",
  },
  {
    href: "#",
    src: "/images/placeholders/logos/producthunt-icon.svg",
    alt: "Product Hunt",
  },
  {
    href: "#",
    src: "/images/placeholders/logos/twitter-icon.svg",
    alt: "Twitter",
  },
];
---

<aside class="top-20 mb-8 w-full self-start md:sticky">
  <!-- <div class="mb-8 flex w-full max-w-fit shrink-0 flex-col md:mb-10 hidden">
    <div class="hidden w-full md:mt-1 md:block">
      <div class="flex w-full items-center space-x-6">
        <a href="#" class="hover:-tranzinc-y-0.5"
          ><img
            src="/images/placeholders/logos/instagram-icon.svg"
            alt="Instagram"
            class="size-5 text-zinc-600"
          /></a
        ><a href="#" class="hover:-tranzinc-y-0.5"
          ><img
            src="/images/placeholders/logos/linkedin-icon.svg"
            alt="LinkedIn"
            class="size-5 text-zinc-600"
          /></a
        ><a href="#" class="hover:-tranzinc-y-0.5"
          ><img
            src="/images/placeholders/logos/producthunt-icon.svg"
            alt="Product Hunt"
            class="size-5 text-zinc-600"
          /></a
        ><a href="#" class="hover:-tranzinc-y-0.5"
          ><img
            src="/images/placeholders/logos/twitter-icon.svg"
            alt="Twitter"
            class="size-5 text-zinc-600"
          /></a
        >
      </div>
    </div>
  </div> -->
  <div
    class="flex flex-col rounded-xl border border-gray-200 bg-white py-6 md:py-8"
  >
    <div class="mb-6 px-6 last:mb-0">
      {
        headings && headings.length > 0 && (
          <nav>
            <div class="md:mb-4.5 mb-6 font-bold leading-5">Overview</div>

            <ul class="space-y-3">
              {headings
                .filter((h) => h.depth === 2 || h.depth === 3) // Show h2/h3 only, adjust as needed
                .map((h) => (
                  <li class={`ml-${(h.depth - 2) * 4}`}>
                    <a
                      href={`#${h.slug ?? h.id}`}
                      class="text-sm text-zinc-600 hover:text-primary-900 transition-colors"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
            </ul>
          </nav>
        )
      }
    </div>
    <div class="mb-6 px-6 last:mb-0">
      <div class="mb-2 font-bold">Categories</div>
      <div class="flex items-center flex-wrap gap-2">
        {
          categories.map((category, index) => (
            <Badge
              key={index}
              label={category}
              href={`/blog/category/${slugify(category)}`}
            />
          ))
        }
      </div>
    </div>
    <div class="mb-6 px-6 last:mb-0">
      <div class="mb-2 font-bold">Tags</div>
      <div class="flex items-center flex-wrap gap-2">
        {
          tags.map((tag, index) => (
            <a
              href={`/blog/tags/${slugify(tag)}`}
              class="text-sm underline hover:text-primary-900 transition-colors"
              key={index}
            >
              #{tag}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</aside>
