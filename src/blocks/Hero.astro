---
import { Image } from "astro:assets";

//component imports
import Button from "@components/ui/Button.astro";

//image
import HeroImage from "@/assets/profile-avatar-1.svg";
---

<section class="" data-scroll-animate>
  <div
    class="grid lg:gap-8 lg:grid-cols-12 gap-10"
  >
    <div class="order-2 md:order-1mr-auto place-self-center lg:col-span-7">
      <div class="space-y-4">
      <p data-scroll-animate>
        Welcome to <strong class="text-primary-600">My Portfolio</strong>
      </p>
      <h1
        class="font-heading max-w-2xl mb-4 text-4xl font-bold tracking-tight leading-none md:text-5xl xl:text-6xl dark:text-white"
         data-scroll-animate
      >
        Frontend Developer Portfolio
      </h1>
      <p
        class="font-body max-w-2xl mb-6 text-gray-500 lg:mb-8 md:text-lg lg:text-xl dark:text-gray-400"
         data-scroll-animate
      >
        Crafting responsive and engaging web experiences with modern
        technologies like React, Astro, and Tailwind CSS. Explore my projects
        and see how I bring ideas to life through code and design.
      </p>
      </div>
      <div class="flex gap-2" data-scroll-animate>
        <a
          href="/projects"
          class="flex flex-1 md:flex-none items-center justify-center px-5 py-3 mr-3 text-base font-medium text-center text-white rounded-lg bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-900"
        >
          View Projects
          <svg
            class="w-5 h-5 ml-2 -mr-1"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              fill-rule="evenodd"
              d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              clip-rule="evenodd"></path></svg
          >
        </a>
        <a
          href="/contact"
          class="flex flex-1 md:flex-none items-center justify-center px-5 py-3 text-base font-medium text-center text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 dark:text-white dark:border-gray-700 dark:hover:bg-gray-700 dark:focus:ring-gray-800"
        >
          Contact Me
        </a>
      </div>
    </div>
    <div class="order-1 md:order-2 lg:mt-0 lg:col-span-5 lg:flex">
      <Image
        src={HeroImage}
        alt="Hero Image"
        class="w-full h-auto"
        layout="constrained"
        priority
        quality={90}
      />
    </div>
  </div>
</section>