---
//astro imports
import type { CollectionEntry } from "astro:content";

//components imports
import BlogCard from "@components/BlogCard.astro";

// Define the expected props interface
interface BlogGridProps {
  posts: CollectionEntry<"posts">[];
}

// Type assertion for Astro.props
const { posts } = Astro.props as BlogGridProps;
---

<div class="grid gap-4 grid-cols-4 md:grid-cols-8 md:gap-12 lg:grid-cols-12">
  {
    posts.map((post) => (
      <div class="col-span-4" data-scroll-animate>
        <BlogCard item={post.data} url={post.id} />
      </div>
    ))
  }
</div>
